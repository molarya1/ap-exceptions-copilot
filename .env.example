# Leave both unset to run the demo from recorded runs (replay mode, no model calls).

# Live runs through your logged-in Claude Code CLI (uses your subscription, not API billing).
# Run `claude` once to log in first. ANTHROPIC_API_KEY is removed from Claude Code's environment.
LIVE_VIA_CLAUDE_CODE=

# Optional alternative: the Messages API with an API key (billed per token).
# Ignored when LIVE_VIA_CLAUDE_CODE=1. `npm run eval` also needs --allow-api-billing for this path.
ANTHROPIC_API_KEY=

# Model and effort for the investigation agent (extraction always uses low effort).
AGENT_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium

# Local web server.
PORT=4310
