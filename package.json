{
  "name": "ap-exceptions-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "An accounts-payable copilot: rules detect, an agent decides through validated tools, a person approves.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "generate": "tsx src/generate/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "eval": "tsx evals/run.ts --live",
    "eval:replay": "tsx evals/run.ts --replay",
    "extract": "tsx evals/run.ts --extract"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@anthropic-ai/sdk": "^1.6.0",
    "sql.js": "^1.15.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/sql.js": "^1.4.11",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
